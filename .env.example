# Set a unique, persistent value in deployment. Do not commit a real .env file.
SECRET_KEY=replace-with-a-long-random-secret
# Enable only behind HTTPS.
SESSION_COOKIE_SECURE=true
# Required only when initializing an empty database; remove after bootstrap.
BILLZEN_BOOTSTRAP_ADMIN_USERNAME=admin@example.local
BILLZEN_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
BILLZEN_BOOTSTRAP_ADMIN_NAME=Administrator
# Optional absolute path to the SAFE BACKUP database.
# DATABASE_PATH=billzen.db
